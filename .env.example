# Database
DATABASE_URL=mysql://root:root@localhost:3306/dreamdriver

# Auth
# Gere uma chave forte e única (ex.: openssl rand -base64 32)
JWT_SECRET=troque-por-uma-chave-secreta-forte

# API (apps/api)
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Frontend (Next.js - apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
# true = mostra check-in no passageiro; omitir ou false = só acompanhar a van (padrão)
# NEXT_PUBLIC_PASSENGER_CHECKIN_ENABLED=true

# Seed de produção (pnpm prisma:seed:prod)
# IMPORTANTE: defina em produção para não usar o admin padrão
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=defina-uma-senha-forte
