{
  "name": "@dream-driver/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:prod": "node prisma/seed.production.js",
    "prisma:wipe-pickup-points": "node prisma/wipe-pickup-points.js",
    "prisma:generate": "prisma generate && node prisma/patch-client-node25.js",
    "prebuild": "node -e \"require('dotenv').config({path:require('path').resolve(process.cwd(),'../../.env')});require('child_process').execSync('prisma generate',{stdio:'inherit',env:process.env});require('child_process').execSync('node prisma/patch-client-node25.js',{stdio:'inherit',env:process.env})\"",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@dream-driver/shared": "workspace:*",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.3.1",
    "mariadb": "^3.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3"
  }
}
